  "artwork_clues": [
    {
      "detail": "THE HANDWRITTEN SIGN",
      "meaning": "The yellow legal pad carries the moment's two-word message. Its ordinary paper and improvised lettering are central to the real stunt, bringing a personal appeal into a televised policy hearing.",
      "kind": "SOURCE_QUALIFIED_ART_INTERPRETATION"
    },
    {
      "detail": "THE NO SIGNS PLAQUE",
      "meaning": "This invented wall fixture makes the raised sign a visual joke about the room's rules. It is illustrative staging, not a claim that this plaque hung at the hearing.",
      "kind": "SOURCE_QUALIFIED_ART_INTERPRETATION"
    },
    {
      "detail": "THE REPORT HEADING",
      "meaning": "MONETARY POLICY REPORT identifies the business of Yellen's appearance. The drawn document is a contextual prop, not a facsimile of her papers or evidence that she wrote the annotations.",
      "kind": "SOURCE_QUALIFIED_ART_INTERPRETATION"
    },
    {
      "detail": "THE ROUNDED PRICE NOTE",
      "meaning": "BTC approximately $2,400 evokes a reported price that afternoon. The amount is rounded for the illustration and does not establish Bitcoin's price at the instant the sign appeared.",
      "kind": "SOURCE_QUALIFIED_ART_INTERPRETATION"
    },
    {
      "detail": "THE 16 BTC FLASHFORWARD",
      "meaning": "This small annotation points to the original sign's 2024 winning auction bid. It deliberately reaches forward seven years; it is not a note made at the 2017 hearing.",
      "kind": "SOURCE_QUALIFIED_ART_INTERPRETATION"
    }
  ],
