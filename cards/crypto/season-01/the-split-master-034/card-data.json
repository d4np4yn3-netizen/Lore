  "artwork_clues": [
    {
      "detail": "The two maps.",
      "meaning": "The return arrow represents recovery; the padlock represents the case for preserving the original rules. They symbolise opposing positions without identifying real people.",
      "kind": "SOURCE_QUALIFIED_SYMBOLIC_INTERPRETATION"
    },
    {
      "detail": "The shared sleepers.",
      "meaning": "The incoming track and wooden sleepers evoke a common history before the divergence. Both routes begin from the same railway.",
      "kind": "SOURCE_QUALIFIED_SYMBOLIC_INTERPRETATION"
    },
    {
      "detail": "Block 1,920,000.",
      "meaning": "The numbered marker identifies the block at which the DAO recovery fork took effect on 20 July 2016. It is a block height, not an amount of Ether.",
      "kind": "SOURCE_QUALIFIED_SYMBOLIC_INTERPRETATION"
    },
    {
      "detail": "The refund station.",
      "meaning": "The station and sealed envelopes turn the recovery contract into a familiar scene of funds being returned. The office and envelopes are invented symbols of an on-chain process.",
      "kind": "SOURCE_QUALIFIED_SYMBOLIC_INTERPRETATION"
    },
    {
      "detail": "ETH and ETC.",
      "meaning": "The two signs identify Ethereum and Ethereum Classic. ETH marks the chain that adopted the recovery change; ETC marks the continuation without it.",
      "kind": "SOURCE_QUALIFIED_SYMBOLIC_INTERPRETATION"
    }
  ],
  "cross_card_cameo": null,
